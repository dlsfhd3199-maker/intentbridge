# Host-specific dependencies, generated files, and local databases
**/node_modules
**/.next
**/out
**/*.tsbuildinfo
**/*.db
**/*.db-*
**/*.sqlite
**/*.sqlite3
**/*.sqlite-*
.validation

# Secrets must enter only through runtime environment variables
**/.env*
**/.npmrc
**/credentials
**/secrets
**/*service-account*.json
**/*service_account*.json
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.log

# Development-only inputs; the application Mock data remains included
.git
.github
.codex
.agents
.vscode
.idea
tests
test-results
playwright-report
coverage
reference
spec
**/*.md
README_START_HERE.txt
playwright.config.ts
eslint.config.mjs
# Keep Dockerfile and .dockerignore in the builder for deployment fingerprinting.
