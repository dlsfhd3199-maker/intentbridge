# No secrets or connection strings. Separate values for each environment.
APP_ENV=development
DATABASE_URL=
AUTH_URL=
AUTH_SECRET=
RESEND_API_KEY=
AUTH_EMAIL_FROM=
INITIAL_ADMIN_EMAIL=
LOG_LEVEL=info
# memory: one staging process; database: shared PostgreSQL, required in production
RATE_LIMIT_STORE=memory
# Only true if trusted ingress overwrites IP headers and blocks direct origin access.
TRUST_PROXY_IP=false
RATE_LIMIT_LOGIN_EMAIL=5
RATE_LIMIT_LOGIN_IP=30
RATE_LIMIT_INVITE=20
RATE_LIMIT_GA4=10
RATE_LIMIT_IMPORT=10
RATE_LIMIT_CAMPAIGN=120
RATE_LIMIT_OPERATION=120
AUDIT_RETENTION_DAYS=365
ALERT_RETENTION_DAYS=90
GA4_DATA_MODE=mock
GA4_PROPERTY_ID=
GA4_PROPERTY_MAP=
GOOGLE_APPLICATION_CREDENTIALS=
CHATGPT_SOURCE_ALIASES=
CHATGPT_PAID_MEDIUMS=
CHATGPT_ORGANIC_MEDIUMS=

# One-time operator secrets; remove after bootstrap. Never commit real values.
INITIAL_ADMIN_PASSWORD=
AUTH_PASSWORD_EMAIL=
AUTH_INITIAL_PASSWORD=
RATE_LIMIT_SIGNUP_IP=10
RATE_LIMIT_SIGNUP_EMAIL=5
